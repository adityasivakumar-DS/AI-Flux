{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "tokenSetOrder": ["component/input"],
    "brand": "AI Flux 2.0",
    "version": "1.0.0"
  },
  "component": {
    "input": {
      "bg": { "$value": "{color.background.secondary}", "$type": "color" },
      "bg-focus": { "$value": "{color.background.tertiary}", "$type": "color" },
      "bg-disabled": { "$value": "{color.interactive.disabled-bg}", "$type": "color" },
      "text": { "$value": "{color.text.primary}", "$type": "color" },
      "text-placeholder": { "$value": "{color.text.muted}", "$type": "color" },
      "text-disabled": { "$value": "{color.text.muted}", "$type": "color" },
      "border": { "$value": "{color.border.default}", "$type": "color" },
      "border-hover": { "$value": "{color.border.strong}", "$type": "color" },
      "border-focus": { "$value": "{color.border.focus}", "$type": "color" },
      "border-error": { "$value": "{color.border.error}", "$type": "color" },
      "border-success": { "$value": "{color.border.success}", "$type": "color" },
      "border-width": { "$value": "{border.width.thin}", "$type": "dimension" },
      "border-radius": { "$value": "{radius.md}", "$type": "dimension" },
      "padding-x": { "$value": "{spacing.4}", "$type": "dimension" },
      "padding-y": { "$value": "{spacing.3}", "$type": "dimension" },
      "font-size": { "$value": "{font.size.body}", "$type": "dimension" },
      "font-family": { "$value": "{font.family.secondary}", "$type": "fontFamily" },
      "focus-ring-color": { "$value": "{color.border.focus}", "$type": "color" },
      "focus-ring-width": { "$value": "2px", "$type": "dimension" },
      "transition-duration": { "$value": "{duration.normal}", "$type": "duration" },
      "label-font-size": { "$value": "{font.size.small}", "$type": "dimension" },
      "label-font-weight": { "$value": "{font.weight.medium}", "$type": "fontWeight" },
      "label-color": { "$value": "{color.text.secondary}", "$type": "color" },
      "helper-font-size": { "$value": "{font.size.caption}", "$type": "dimension" },
      "helper-color": { "$value": "{color.text.muted}", "$type": "color" },
      "error-color": { "$value": "{color.text.error}", "$type": "color" },
      "height-sm": { "$value": "32px", "$type": "dimension" },
      "height-md": { "$value": "40px", "$type": "dimension" },
      "height-lg": { "$value": "48px", "$type": "dimension" }
    }
  }
}
