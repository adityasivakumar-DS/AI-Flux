{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "tokenSetOrder": ["component/button"],
    "brand": "AI Flux 2.0",
    "version": "1.0.0"
  },
  "component": {
    "button": {
      "font-family": { "$value": "{font.family.primary}", "$type": "fontFamily" },
      "font-weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" },
      "letter-spacing": { "$value": "{font.letter-spacing.wide}", "$type": "dimension" },
      "transition-duration": { "$value": "{duration.normal}", "$type": "duration" },
      "transition-easing": { "$value": "{easing.ease-out}", "$type": "cubicBezier" },
      "focus-ring-width": { "$value": "{border.width.medium}", "$type": "dimension" },
      "focus-ring-offset": { "$value": "2px", "$type": "dimension" },
      "focus-ring-color": { "$value": "{color.border.focus}", "$type": "color" },

      "primary": {
        "bg": { "$value": "{color.interactive.primary-bg}", "$type": "color" },
        "bg-hover": { "$value": "{color.interactive.primary-bg-hover}", "$type": "color" },
        "bg-active": { "$value": "{color.interactive.primary-bg-active}", "$type": "color" },
        "text": { "$value": "{color.interactive.primary-text}", "$type": "color" },
        "border": { "$value": "{color.transparent}", "$type": "color" },
        "shadow-hover": { "$value": "{shadow.glow-purple}", "$type": "shadow" }
      },
      "secondary": {
        "bg": { "$value": "{color.interactive.secondary-bg}", "$type": "color" },
        "bg-hover": { "$value": "{color.interactive.secondary-bg-hover}", "$type": "color" },
        "text": { "$value": "{color.interactive.secondary-text}", "$type": "color" },
        "border": { "$value": "{color.interactive.secondary-border}", "$type": "color" }
      },
      "ghost": {
        "bg": { "$value": "{color.transparent}", "$type": "color" },
        "bg-hover": { "$value": "{color.interactive.ghost-bg-hover}", "$type": "color" },
        "text": { "$value": "{color.interactive.ghost-text}", "$type": "color" },
        "border": { "$value": "{color.transparent}", "$type": "color" }
      },
      "destructive": {
        "bg": { "$value": "{color.status-error}", "$type": "color" },
        "bg-hover": { "$value": "#DC2626", "$type": "color" },
        "text": { "$value": "{color.neutral-white}", "$type": "color" },
        "border": { "$value": "{color.transparent}", "$type": "color" }
      },
      "disabled": {
        "bg": { "$value": "{color.interactive.disabled-bg}", "$type": "color" },
        "text": { "$value": "{color.interactive.disabled-text}", "$type": "color" },
        "border": { "$value": "{color.interactive.disabled-border}", "$type": "color" },
        "opacity": { "$value": "{opacity.50}", "$type": "number" }
      },

      "size": {
        "sm": {
          "padding-x": { "$value": "{spacing.4}", "$type": "dimension" },
          "padding-y": { "$value": "{spacing.2}", "$type": "dimension" },
          "font-size": { "$value": "{font.size.small}", "$type": "dimension" },
          "border-radius": { "$value": "{radius.md}", "$type": "dimension" },
          "min-height": { "$value": "32px", "$type": "dimension" }
        },
        "md": {
          "padding-x": { "$value": "{spacing.6}", "$type": "dimension" },
          "padding-y": { "$value": "{spacing.3}", "$type": "dimension" },
          "font-size": { "$value": "{font.size.body}", "$type": "dimension" },
          "border-radius": { "$value": "{radius.md}", "$type": "dimension" },
          "min-height": { "$value": "40px", "$type": "dimension" }
        },
        "lg": {
          "padding-x": { "$value": "{spacing.8}", "$type": "dimension" },
          "padding-y": { "$value": "{spacing.4}", "$type": "dimension" },
          "font-size": { "$value": "{font.size.body-large}", "$type": "dimension" },
          "border-radius": { "$value": "{radius.lg}", "$type": "dimension" },
          "min-height": { "$value": "48px", "$type": "dimension" }
        }
      }
    }
  }
}
