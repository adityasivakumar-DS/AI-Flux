{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "tokenSetOrder": ["semantic/spacing"],
    "brand": "AI Flux 2.0",
    "version": "1.0.0"
  },
  "spacing": {
    "component": {
      "xs": { "$value": "{spacing.2}", "$type": "dimension", "$description": "Compact — icon gaps, tight chips" },
      "sm": { "$value": "{spacing.3}", "$type": "dimension", "$description": "Small — button padding-y" },
      "md": { "$value": "{spacing.4}", "$type": "dimension", "$description": "Medium — default padding" },
      "lg": { "$value": "{spacing.6}", "$type": "dimension", "$description": "Large — card padding" },
      "xl": { "$value": "{spacing.8}", "$type": "dimension", "$description": "Extra large — section padding" }
    },
    "layout": {
      "page-x": { "$value": "{spacing.8}", "$type": "dimension", "$description": "Horizontal page margin (mobile)" },
      "page-x-lg": { "$value": "{spacing.16}", "$type": "dimension", "$description": "Horizontal page margin (desktop)" },
      "section-y": { "$value": "{spacing.16}", "$type": "dimension", "$description": "Section vertical padding" },
      "section-y-lg": { "$value": "{spacing.24}", "$type": "dimension", "$description": "Section vertical padding (desktop)" },
      "gutter": { "$value": "{spacing.6}", "$type": "dimension", "$description": "Grid gutter" },
      "sidebar-width": { "$value": "260px", "$type": "dimension" },
      "topbar-height": { "$value": "64px", "$type": "dimension" }
    },
    "stack": {
      "xs": { "$value": "{spacing.2}", "$type": "dimension" },
      "sm": { "$value": "{spacing.4}", "$type": "dimension" },
      "md": { "$value": "{spacing.6}", "$type": "dimension" },
      "lg": { "$value": "{spacing.8}", "$type": "dimension" },
      "xl": { "$value": "{spacing.12}", "$type": "dimension" },
      "2xl": { "$value": "{spacing.16}", "$type": "dimension" }
    }
  }
}
