{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "tokenSetOrder": ["core/typography"],
    "brand": "AI Flux 2.0",
    "version": "1.0.0"
  },
  "font": {
    "family": {
      "primary": {
        "$value": "'Space Grotesk', sans-serif",
        "$type": "fontFamily",
        "$description": "Primary brand typeface — modern, geometric, confident"
      },
      "secondary": {
        "$value": "'Inter', sans-serif",
        "$type": "fontFamily",
        "$description": "Secondary typeface — readable, neutral, UI-optimised"
      },
      "mono": {
        "$value": "'JetBrains Mono', 'Fira Code', monospace",
        "$type": "fontFamily",
        "$description": "Monospace — code, technical content"
      }
    },
    "weight": {
      "regular": {
        "$value": 400,
        "$type": "fontWeight",
        "$description": "Regular weight"
      },
      "medium": {
        "$value": 500,
        "$type": "fontWeight",
        "$description": "Medium weight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight",
        "$description": "Semibold weight"
      },
      "bold": {
        "$value": 700,
        "$type": "fontWeight",
        "$description": "Bold weight"
      }
    },
    "size": {
      "display-1": {
        "$value": "48px",
        "$type": "dimension",
        "$description": "Largest display heading — hero sections, key metrics"
      },
      "display-2": {
        "$value": "36px",
        "$type": "dimension",
        "$description": "Secondary display — section heroes"
      },
      "heading-1": {
        "$value": "28px",
        "$type": "dimension",
        "$description": "Page-level heading"
      },
      "heading-2": {
        "$value": "22px",
        "$type": "dimension",
        "$description": "Section heading"
      },
      "heading-3": {
        "$value": "18px",
        "$type": "dimension",
        "$description": "Sub-section heading"
      },
      "body-large": {
        "$value": "16px",
        "$type": "dimension",
        "$description": "Large body text — intros, emphasis"
      },
      "body": {
        "$value": "14px",
        "$type": "dimension",
        "$description": "Default body text"
      },
      "small": {
        "$value": "12px",
        "$type": "dimension",
        "$description": "Small text — labels, metadata"
      },
      "caption": {
        "$value": "10px",
        "$type": "dimension",
        "$description": "Caption text — legal, footnotes, timestamps"
      }
    },
    "line-height": {
      "display-1": {
        "$value": "56px",
        "$type": "dimension"
      },
      "display-2": {
        "$value": "44px",
        "$type": "dimension"
      },
      "heading-1": {
        "$value": "36px",
        "$type": "dimension"
      },
      "heading-2": {
        "$value": "30px",
        "$type": "dimension"
      },
      "heading-3": {
        "$value": "26px",
        "$type": "dimension"
      },
      "body-large": {
        "$value": "24px",
        "$type": "dimension"
      },
      "body": {
        "$value": "22px",
        "$type": "dimension"
      },
      "small": {
        "$value": "16px",
        "$type": "dimension"
      },
      "caption": {
        "$value": "14px",
        "$type": "dimension"
      }
    },
    "letter-spacing": {
      "tight": {
        "$value": "-0.02em",
        "$type": "dimension"
      },
      "normal": {
        "$value": "0em",
        "$type": "dimension"
      },
      "wide": {
        "$value": "0.05em",
        "$type": "dimension"
      },
      "wider": {
        "$value": "0.1em",
        "$type": "dimension"
      }
    }
  }
}
