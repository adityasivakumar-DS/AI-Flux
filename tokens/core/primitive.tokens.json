{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "tokenSetOrder": ["core/color", "core/typography", "core/spacing", "core/radius", "core/border", "core/motion", "core/shadow", "core/opacity", "core/z-index"],
    "brand": "AI-Flux",
    "version": "1.0.0",
    "description": "Consolidated W3C DTCG primitive tokens — raw values, no aliases"
  },
  "color": {
    "flux-navy":         { "$value": "#0D0E1A",    "$type": "color" },
    "flux-purple":       { "$value": "#7C3AED",    "$type": "color" },
    "flux-purple-dark":  { "$value": "#6D28D9",    "$type": "color" },
    "flux-purple-darker":{ "$value": "#5B21B6",    "$type": "color" },
    "flux-purple-light": { "$value": "#A78BFA",    "$type": "color" },
    "flux-purple-faint": { "$value": "#1E1033",    "$type": "color" },
    "flux-blue":         { "$value": "#2563EB",    "$type": "color" },
    "flux-blue-dark":    { "$value": "#1D4ED8",    "$type": "color" },
    "flux-blue-light":   { "$value": "#60A5FA",    "$type": "color" },
    "flux-blue-faint":   { "$value": "#0F1E3D",    "$type": "color" },
    "flux-cyan":         { "$value": "#00E5FF",    "$type": "color" },
    "flux-cyan-dark":    { "$value": "#00B8D9",    "$type": "color" },
    "flux-cyan-faint":   { "$value": "#001E2E",    "$type": "color" },
    "flux-green":        { "$value": "#00C896",    "$type": "color" },
    "flux-green-dark":   { "$value": "#00A87E",    "$type": "color" },
    "flux-green-faint":  { "$value": "#001E17",    "$type": "color" },
    "neutral-dark":      { "$value": "#0F172A",    "$type": "color" },
    "neutral-slate":     { "$value": "#1E293B",    "$type": "color" },
    "neutral-gray":      { "$value": "#334155",    "$type": "color" },
    "neutral-cool-gray": { "$value": "#64748B",    "$type": "color" },
    "neutral-light":     { "$value": "#E2EBF0",    "$type": "color" },
    "neutral-off-white": { "$value": "#F8FAFC",    "$type": "color" },
    "neutral-white":     { "$value": "#FFFFFF",    "$type": "color" },
    "status-warning":    { "$value": "#F59E0B",    "$type": "color" },
    "status-warning-faint":{ "$value": "#1C1300",  "$type": "color" },
